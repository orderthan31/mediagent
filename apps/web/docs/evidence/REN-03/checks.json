[
  {
    "name": "format",
    "command": [
      "node",
      "node_modules/prettier/bin/prettier.cjs",
      "--write",
      "src/VideoWorkspace.tsx",
      "src/StorageVideo.tsx",
      "src/StorageUploads.tsx",
      "src/storage.css",
      "tests/browser/storage-upload.spec.ts"
    ],
    "exit": 0
  },
  {
    "name": "lint",
    "command": [
      "npm",
      "run",
      "lint"
    ],
    "exit": 1
  },
  {
    "name": "format-check",
    "command": [
      "npm",
      "run",
      "format:check"
    ],
    "exit": 0
  },
  {
    "name": "build",
    "command": [
      "npm",
      "run",
      "build"
    ],
    "exit": 0
  },
  {
    "name": "related-tests",
    "command": [
      "node",
      "--test",
      "tests/upload-queue.test.mjs",
      "tests/upload-verification.test.mjs",
      "tests/video-file.test.mjs"
    ],
    "exit": 0
  },
  {
    "name": "browser",
    "command": [
      "node",
      "node_modules/@playwright/test/cli.js",
      "test",
      "tests/browser/storage-upload.spec.ts"
    ],
    "exit": 0
  },
  {
    "name": "doctor",
    "command": [
      "./node_modules/.bin/hangyeol",
      "doctor"
    ],
    "exit": 0
  }
]