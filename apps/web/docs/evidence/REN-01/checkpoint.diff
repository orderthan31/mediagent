+  }
+  [data-hangyeol][data-palette="Amber"][data-theme="light"] {
+    --g-action: #F59E0B; --g-action-hover: #FBBF24; --g-on-action: #0F172A; --g-focus: #92400E;
+  }
+  [data-hangyeol][data-palette="Amber"][data-theme="dark"] {
+    --g-action: #FCD34D; --g-action-hover: #FCDA68; --g-on-action: #0F172A; --g-focus: #FCD34D;
+  }
+  [data-hangyeol][data-palette="Rose"][data-theme="light"] {
+    --g-action: #E11D48; --g-action-hover: #BE123C; --g-on-action: #FFFFFF; --g-focus: #BE123C;
+  }
+  [data-hangyeol][data-palette="Rose"][data-theme="dark"] {
+    --g-action: #F472B6; --g-action-hover: #F687C1; --g-on-action: #0F172A; --g-focus: #F472B6;
+  }
+}
