[
  {
    "name": "format-final",
    "command": [
      "node",
      "node_modules/prettier/bin/prettier.cjs",
      "--write",
      "src/JobDetail.tsx",
      "src/StageProgress.tsx",
      "src/SubtitleEditor.tsx",
      "src/TicketSummary.tsx",
      "src/ticket.css",
      "tests/browser/ticket-review.spec.ts"
    ],
    "exit": 0
  },
  {
    "name": "lint",
    "command": [
      "npm",
      "run",
      "lint"
    ],
    "exit": 0
  },
  {
    "name": "format-check",
    "command": [
      "npm",
      "run",
      "format:check"
    ],
    "exit": 0
  },
  {
    "name": "build",
    "command": [
      "npm",
      "run",
      "build"
    ],
    "exit": 0
  },
  {
    "name": "browser-types",
    "command": [
      "node",
      "node_modules/typescript/bin/tsc",
      "-p",
      "tests/browser/tsconfig.json"
    ],
    "exit": 0
  },
  {
    "name": "related-tests",
    "command": [
      "node",
      "--test",
      "tests/job-failure.test.mjs"
    ],
    "exit": 0
  },
  {
    "name": "browser-final",
    "command": [
      "node",
      "node_modules/@playwright/test/cli.js",
      "test",
      "tests/browser/ticket-review.spec.ts"
    ],
    "exit": 0
  },
  {
    "name": "doctor",
    "command": [
      "./node_modules/.bin/hangyeol",
      "doctor"
    ],
    "exit": 0
  }
]