{
  "name": "video-subtitle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/*.mjs\" \"*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/*.mjs\" \"*.{ts,mjs,json,md}\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@orderthan31/hangyeol-core": "file:vendor/orderthan31-hangyeol-core-0.0.2-adapter.1.tgz",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
