# Copy to .env.docker and set your key there. Never commit real keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash
GEMINI_TRANSLATION_MODEL=gemini-3.8-flash
GEMINI_AUDIO_FILTER_MODEL=gemini-3.8-flash
VOCALIZATION_FILTER_ENABLED=false

# CPU by default. docker-compose.gpu.yml overrides these for NVIDIA NVENC.
VIDEO_ENCODER=libx265
ALLOW_SOFTWARE_ENCODER_FALLBACK=true
DOCKER_WEB_PORT=8080
DOCKER_API_PORT=8000

# Localhost-only HTTP preview. Enable authentication + HTTPS before exposure.
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
WEB_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

MAX_UPLOAD_BYTES=10737418240
VIDEO_SERVICE_QUOTA_BYTES=322122547200
MIN_FREE_SPACE_BYTES=53687091200
MAX_ENCODING_JOBS=1

# Used only when explicitly running --collect-only; no automatic deletion.
RESULT_TTL_HOURS=24
HISTORY_TTL_DAYS=90
UPLOAD_TTL_HOURS=6
REVIEW_TTL_HOURS=24
ORPHAN_GRACE_HOURS=2
# MVP3 ipDISK FTP connection (reserved; not consumed by the application yet).
# Use a LAN host/IP only; do not embed credentials in a URL.
# Paths are relative to the FTP account root. Keep secrets in local env files.
IPDISK_FTP_HOST=
IPDISK_FTP_PORT=
IPDISK_FTP_USERNAME=
IPDISK_FTP_PASSWORD=
IPDISK_FTP_SOURCE_DIR=
IPDISK_FTP_OUTPUT_DIR=
# Optional: existing directory on the physical drive to monitor (default: ./scripts).
# Set this to a directory on the Docker data drive if Docker stores its virtual disk elsewhere.
HOST_DISK_PROBE_DIR=./scripts
# Queue scheduling: resource limits are shared across worker processes.
MAX_CONCURRENT_JOBS=3
MAX_GPU_JOBS=1
MAX_IO_JOBS=2
MAX_LLM_JOBS=1
AUTO_RESUME_INTERRUPTED=true
MAX_AUTO_RECOVERIES=2
JOB_INDEX_ENABLED=true
