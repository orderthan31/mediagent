{
  "$id": "urn:mideagent:agent.result.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "command",
    "result"
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_key",
        "sha256",
        "bytes",
        "type"
      ],
      "properties": {
        "storage_key": {
          "type": "string",
          "pattern": "^blobs/[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "type": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "attempt_id",
        "generation",
        "agent",
        "inputs",
        "options"
      ],
      "properties": {
        "protocol_version": {
          "const": 1,
          "type": "integer"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "enum": [
                "analyze",
                "encode",
                "extract_audio",
                "generate_subtitle",
                "preprocess_audio",
                "validate_video"
              ]
            },
            "revision": {
              "const": "1"
            }
          }
        },
        "inputs": {
          "type": "object"
        },
        "options": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "properties": {
            "agent": {
              "properties": {
                "id": {
                  "const": "analyze"
                }
              }
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "video": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifact"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "video"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "video"
              ]
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          }
        },
        {
          "properties": {
            "agent": {
              "properties": {
                "id": {
                  "const": "encode"
                }
              }
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "video": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifact"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "video"
                        }
                      }
                    }
                  ]
                },
                "subtitles": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifact"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "subtitle"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "video"
              ]
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "subtitle_mode": {
                  "enum": [
                    "burn",
                    "soft",
                    "none"
                  ]
                },
                "video_codec": {
                  "enum": [
                    "h264",
                    "hevc"
                  ]
                },
                "resolution": {
                  "enum": [
                    "original",
                    "1080p",
                    "720p"
                  ]
                },
                "quality_profile": {
                  "enum": [
                    "balanced",
                    "high",
                    "compact"
                  ]
                }
              }
            }
          },
          "if": {
            "properties": {
              "options": {
                "required": [
                  "subtitle_mode"
                ],
                "properties": {
                  "subtitle_mode": {
                    "const": "none"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "not": {
                  "required": [
                    "subtitles"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "inputs": {
                "required": [
                  "subtitles"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "agent": {
              "properties": {
                "id": {
                  "const": "extract_audio"
                }
              }
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "video": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifact"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "video"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "video"
              ]
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          }
        },
        {
          "properties": {
            "agent": {
              "properties": {
                "id": {
                  "const": "generate_subtitle"
                }
              }
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "transcript": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifact"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "transcript"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "transcript"
              ]
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          }
        },
        {
          "properties": {
            "agent": {
              "properties": {
                "id": {
                  "const": "preprocess_audio"
                }
              }
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "audio": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifact"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "audio"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "audio"
              ]
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "audio_filter": {
                  "enum": [
                    "off",
                    "conservative",
                    "strong",
                    "silence3"
                  ]
                },
                "vad_mode": {
                  "enum": [
                    "off",
                    "nvidia"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "agent": {
              "properties": {
                "id": {
                  "const": "validate_video"
                }
              }
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "video": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifact"
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "video"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "video"
              ]
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "attempt_id",
        "generation",
        "outputs",
        "protocol_version",
        "request_sha256",
        "run_id",
        "status",
        "transport"
      ],
      "properties": {
        "protocol_version": {
          "const": 1,
          "type": "integer"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "enum": [
                "analyze",
                "encode",
                "extract_audio",
                "generate_subtitle",
                "preprocess_audio",
                "validate_video"
              ]
            },
            "revision": {
              "const": "1"
            }
          }
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "transport": {
          "const": "s3_subprocess"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "outputs": {
            "maxProperties": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        },
        "properties": {
          "outputs": {
            "minProperties": 1
          }
        }
      }
    }
  }
}
